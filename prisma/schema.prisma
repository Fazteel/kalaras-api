

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

enum Tier {
  free
  premium
}

enum TransactionStatus {
  pending
  settlement
  expire
  cancel
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password_hash     String
  phone             String?
  phone_verified    Boolean            @default(false)
  role              Role               @default(user)
  tier              Tier               @default(free)
  referral_code     String             @unique @default(cuid())
  referred_by       String?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  consent_at        DateTime?
  consent_type      String?
  pocket_profile    PocketProfile?
  medical_profile   MedicalProfile?
  emergency_contact EmergencyContact[]
  check_in_logs     CheckInLog[]
  journal_entries   JournalEntry[]
  formal_documents  FormalDocument[]
  transactions      Transaction[]
  location_log      LocationLog?
  alert_logs        AlertLog[]
  safety_sessions   SafetySession[]
  kalaras_histories KalarasHistory[]
  private_nurse    PrivateNurse?
  privacy_settings PrivacySettings?
  notifications    Notification[]
}

model PocketProfile {
  id               String   @id @default(uuid())
  user_id          String   @unique
  user             User     @relation(fields: [user_id], references: [id])
  full_name        String
  religion         String
  marital_status   String   @default("Belum Menikah")
  avatar_url       String?
  birth_place_date String?
  address          String?  @db.Text
  updated_at       DateTime @updatedAt
}

model MedicalProfile {
  id              String   @id @default(uuid())
  user_id         String   @unique
  user            User     @relation(fields: [user_id], references: [id])
  allergies       String?  @db.Text
  medical_history String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model CheckInLog {
  id           String    @id @default(uuid())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id])
  sent_at      DateTime  @default(now())
  responded_at DateTime?
  status       String
  mood         String?
  notes        String?   @db.Text
  stress_level Int?
}

model ChatbotTemplate {
  id                String   @id @default(uuid())
  intent            String   @unique
  keywords          String
  response_template String   @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model EmergencyContact {
  id             String   @id @default(uuid())
  user_id        String
  user           User     @relation(fields: [user_id], references: [id])
  name           String
  relation       String
  phone          String
  priority_order Int
  created_at     DateTime @default(now())
}

model JournalEntry {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model FormalDocument {
  id              String   @id @default(uuid())
  user_id         String
  user            User     @relation(fields: [user_id], references: [id])
  document_type   String
  file_url        String
  file_name       String
  file_size_bytes Int?
  encrypted_key   String?
  access_rules    Json?
  created_at      DateTime @default(now())
}

model Transaction {
  id           String            @id @default(uuid())
  user_id      String
  user         User              @relation(fields: [user_id], references: [id])
  order_id     String            @unique
  gross_amount Decimal
  status       TransactionStatus
  snap_token   String?
  paid_at      DateTime?
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
}

model LocationLog {
  id          String   @id @default(uuid())
  user_id     String   @unique
  user        User     @relation(fields: [user_id], references: [id])
  latitude    Float
  longitude   Float
  recorded_at DateTime
}

model AlertLog {
  id           String    @id @default(uuid())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id])
  alert_type   String
  recipients   Json
  status       String
  triggered_at DateTime
  delivered_at DateTime?
}

model SafetySession {
  id               String    @id @default(uuid())
  user_id          String
  user             User      @relation(fields: [user_id], references: [id])
  duration_seconds Int
  preset_label     String?
  status           String
  started_at       DateTime
  expires_at       DateTime
  confirmed_at     DateTime?
}

model KalarasHistory {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_message String   @db.Text
  ai_reply     String   @db.Text
  created_at   DateTime @default(now())
}

model PrivateNurse {
  id                   String   @id @default(uuid())
  user_id              String   @unique
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  is_active            Boolean  @default(true)
  condition_target     String?
  medication_name      String?
  medication_schedule  String?
  dietary_restrictions String?
  doctor_instructions  String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  body       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model PrivacySettings {
  id                 String   @id @default(uuid())
  user_id            String   @unique
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  medical_encryption Boolean  @default(true)
  biometric_login    Boolean  @default(false)
  location_tracking  Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportConfig {
  id              Int      @id @default(autoincrement())
  whatsapp_number String
  default_message String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AppInfo {
  id             Int      @id @default(autoincrement())
  app_name       String
  latest_version String
  release_date   String
  force_update   Boolean  @default(false)
  copyright      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}